# ============================================================
# PathSeek — Plantilla de variables de entorno de PRODUCCIÓN
# ============================================================
# INSTRUCCIONES:
#   1. Copiar este archivo al VPS como: ~/pathseek/.env
#   2. Rellenar TODOS los valores marcados con <...>
#   3. Asegurar permisos: chmod 600 .env
#   4. NUNCA subir el .env al repositorio Git
# ============================================================

# --- Base de Datos PostgreSQL ---
DB_NAME=pathseek_prod
DB_USER=pathseek_prod
DB_PASSWORD=<CONTRASEÑA_SEGURA_GENERADA>
# Generar con: openssl rand -base64 32

# --- Seguridad Backend / JWT ---
JWT_SECRET=<JWT_SECRET_64_BYTES_HEX>
# Generar con: openssl rand -hex 64
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- CORS — origen(es) de producción (IP) ---
CORS_ALLOWED_ORIGINS=https://169.58.74.99,http://169.58.74.99

# --- Bootstrap Admin (solo primer despliegue, desactivar después) ---
APP_BOOTSTRAP_USER_ENABLED=true
APP_BOOTSTRAP_USER_NAME=Administrador PathSeek
APP_BOOTSTRAP_USER_EMAIL=admin@pathseek.pe
APP_BOOTSTRAP_USER_PASSWORD=<CONTRASEÑA_ADMIN_INICIAL_SEGURA>
APP_BOOTSTRAP_USER_ROLE=ADMIN
