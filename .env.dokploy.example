# ============================================================
# PathSeek — Variables de Entorno para Despliegue en Dokploy
# ============================================================
# INSTRUCCIONES:
#   Copiar estas variables al panel de "Environment" en Dokploy
#   dentro del servicio Compose.
# ============================================================

# --- Puerto y Red Frontend ---
FRONTEND_PORT=8085
API_BASE_URL=http://169.58.74.99:8085
CORS_ALLOWED_ORIGINS=http://169.58.74.99:8085,http://169.58.74.99

# --- Base de Datos PostgreSQL ---
DB_NAME=pathseek_prod
DB_USER=pathseek_prod
DB_PASSWORD=reemplazar_con_password_seguro_postgres
# Generar con: openssl rand -base64 32

# --- Seguridad Backend / JWT ---
JWT_SECRET=reemplazar_con_secret_hex_64_bytes
# Generar con: openssl rand -hex 64
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
SESSION_INACTIVITY_MINUTES=30

# --- Motor de Optimización de Rutas OSRM ---
REOPTIMIZATION_BUDGET_MS=25000
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org

# --- Bootstrap Inicial del Usuario Administrador ---
APP_BOOTSTRAP_USER_ENABLED=true
APP_BOOTSTRAP_USER_NAME=Administrador PathSeek
APP_BOOTSTRAP_USER_EMAIL=admin@pathseek.pe
APP_BOOTSTRAP_USER_PASSWORD=reemplazar_con_password_admin_seguro
APP_BOOTSTRAP_USER_ROLE=ADMIN
